# Optional Twitch integration. Demo mode works without these values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must exactly match the OAuth redirect URI registered in your Twitch application.
# For local use: http://localhost:3000/auth/twitch/callback
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Required to encrypt Twitch access/refresh tokens at rest. Generate with: openssl rand -hex 32
HABITAT_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

PORT=3000
HOST=0.0.0.0
# Optional; defaults to ./data/habitat-relay.sqlite
# HABITAT_DB_PATH=./data/habitat-relay.sqlite
