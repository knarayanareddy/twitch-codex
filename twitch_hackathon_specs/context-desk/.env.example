# Context Desk local configuration. Never put a real Twitch token or secret in browser code.
PORT=4173
HOST=0.0.0.0
DATABASE_PATH=./data/context-desk.sqlite

# Local review login. For a local-only demo set DEMO_MODE=1 and a private passphrase
# of at least 12 characters. For a non-demo deployment, use an access token of at
# least 24 characters plus a cookie secret of 32 bytes. No default passphrase ships.
DEMO_MODE=1
DEMO_PASSCODE=
CONTEXT_DESK_ACCESS_TOKEN=
CONTEXT_DESK_COOKIE_SECRET=
CONTEXT_DESK_SESSION_ID=
TRUST_PROXY_HTTPS=0

# Optional Twitch OAuth + signed EventSub webhook. The public callbacks must be HTTPS,
# reachable from Twitch, and registered in the Twitch Developer Console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://your-public-host.example/auth/twitch/callback
TWITCH_EVENTSUB_CALLBACK_URL=https://your-public-host.example/api/twitch/eventsub
TWITCH_EVENTSUB_SECRET=
TWITCH_BROADCASTER_ID=
# Generate each secret independently (for example: openssl rand -hex 32).
CONTEXT_DESK_ENCRYPTION_KEY=
