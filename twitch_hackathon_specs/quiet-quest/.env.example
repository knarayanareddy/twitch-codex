# Local demo. The passphrase grants only this local studio session.
HOST=0.0.0.0
PORT=4180
NODE_ENV=development
DEMO_MODE=1
DEMO_PASSCODE=quiet-quest-local-demo

# Production/operator setup (use a long, private value; keep it out of Git).
QUIET_QUEST_OPERATOR_PASSCODE=
QUIET_QUEST_COOKIE_SECRET=
DATABASE_PATH=./data/quiet-quest.sqlite

# Optional Twitch installed-chat flow. Callback must exactly match the URL registered in the Twitch developer console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://your-public-host.example/auth/twitch/callback
# Optional 64-hex key. If empty, a 0600 key file is generated under data/; keep it with the database backups.
TWITCH_TOKEN_ENCRYPTION_KEY=
# Set to 1 only behind a correctly configured HTTPS reverse proxy.
TRUST_PROXY_HTTPS=0
